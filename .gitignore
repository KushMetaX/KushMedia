# Environment files with secrets (never commit — use cPanel Node env vars and/or gitignored files on server)
.env
.env.local
.env.production
public/.env

assets/videos/
assets/audio/
assets/videos/
assets/tile-cnc/*.mp4
gallery/*.mp4
gallery/*.zip
gallery/
