server/data/.dd-admin-ui-password
server/data/.dd-community-password
server/data/.voyager-password
public/server/data/.voyager-password
.voyager-password

# Voyager scraper raw responses + cached output (regenerated by `npm run scrape`)
_tools/voyager-scraper/data/raw/
_tools/voyager-scraper/data/out/*.json
!_tools/voyager-scraper/data/out/.gitkeep
public/server/data/dd-tip-intents.ndjson
server/data/.session-secret
public/server/data/.coingecko-api-key
# Runtime / host noise (do not commit)
**/api/error_log
**/public/stderr.log
**/node_modules.zip

# NPM — CloudLinux Node Selector manages node_modules via symlink; never commit/deploy a real folder
node_modules/
public/node_modules/
