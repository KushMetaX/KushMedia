PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# SESSION_SECRET signs HttpOnly cookies only — not a login password. Non-empty value must be 16+ chars after trim.
# Also accepted: SESSION_SECRET_FILE=/absolute/path OR a single-line file at server/data/.session-secret (gitignored).
# If unset, the server writes a random value to server/data/.session-secret on first boot.
# SESSION_SECRET=your-long-random-secret-at-least-16-chars
# SESSION_SECRET_FILE=

# Optional: set to 0 / false / off / no to block new signups (default: registration allowed)
# AUTH_ALLOW_REGISTRATION=

# SQLite database for users, sessions, dex entries. Defaults to server/data/doginaldex.sqlite
# DEX_DB_PATH=

# Optional SMTP for password reset emails (forgot-password returns 200 either way)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional: force Secure cookies when behind a proxy without HTTPS termination awareness
# FORCE_SECURE_COOKIES=0

# Discord OAuth for tournament player accounts (no password stored). Callback must NOT
# live under /api/auth — LiteSpeed traps /api/* for PHP. Use /kmx-auth (and /kk-auth if needed).
# Register the redirect URI on the Discord application: https://<host>/kmx-auth/discord/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=https://kushmedia.xyz/kmx-auth/discord/callback

# Optional: override the default catalog path (server/data/DoginalDogsCatalog.json)
# DD_CATALOG_PATH=D:\path\to\DoginalDogsCatalog.json

# Optional: set to 1 to bypass the local catalog and force live market reads
# DD_DISABLE_CATALOG=0

# Optional: enables the admin dashboard at ADMIN_PATH (HTTP Basic Auth, timing-safe).
# Fail-closed: if the path, ADMIN_USER, or a password is missing, the UI is 404.
# Never commit the live path or password. Old /admin and /admin.html always 404.
# The browser prompt is the login (realm "Restricted") — do not put this value in client JS.
# API saves still use DD_ADMIN_PASSWORD (header or Basic password).
# ADMIN_PATH=/put-a-long-unguessable-path-here
# ADMIN_URL is an alias for ADMIN_PATH (path only, or a full https://kushmedia.xyz/… URL).
# ADMIN_USER=admin
# ADMIN_PASS=change-me
# ADMIN_PASS aliases: DD_ADMIN_PASSWORD, DD_ADMIN_UI_PASSWORD (and their _FILE fallbacks).
# DD_ADMIN_PASSWORD=change-me
# DD_ADMIN_PASSWORD_FILE=D:\path\to\.dd-admin-password
# Optional separate password for Basic auth on the admin HTML (defaults to DD_ADMIN_PASSWORD if unset).
# DD_ADMIN_UI_PASSWORD=admin-html-basic-gate
# DD_COMMUNITY_PASSWORD=optional-community-submit

# Optional: override the shared DD evaluator trend config file path.
# Defaults to server/data/dd-trending-config.json.
# DD_TRENDING_CONFIG_PATH=D:\path\to\dd-trending-config.json

# Guest quotas (Node dd-paywall.js; PHP evaluate mirrors same env names).
# Per UTC calendar day per client IP when the user is not Doginal Dogs Plus.
# DD_FREE_INSCRIPTION_PER_DAY=2
# DD_FREE_RARITY_LOOKUPS_PER_DAY=1

# --- Doginal Dogs Plus (crypto prepay via NOWPayments-class API) ---
# API key from your crypto payment provider (NOWPayments: Store → API keys).
# CRYPTO_PAY_API_KEY=
# IPN secret from the same dashboard (used to verify POST /api/webhooks/crypto-payments).
# CRYPTO_PAY_IPN_SECRET=
# Set to 1 / true to use sandbox API host (https://api-sandbox.nowpayments.io).
# CRYPTO_PAY_SANDBOX=0
# Comma-separated list of pay_currency codes offered in the evaluator (lowercase tickers).
# CRYPTO_PAY_ALLOWED_CURRENCIES=btc,eth,sol,doge
# Public HTTPS origin without trailing slash (success/cancel URLs + IPN path).
# PUBLIC_SITE_URL=https://kushmedia.xyz
# Display USD amounts shown in UI; charged fiat reference for provider (actual crypto amount comes from provider).
# DD_PRICE_MONTH_DISPLAY=9.99
# DD_PRICE_YEAR_DISPLAY=100
# Days added to the current Plus expiry (or from now) after a finished payment — prepaid "month" / "year".
# DD_PLUS_MONTH_DAYS=30
# DD_PLUS_YEAR_DAYS=365
# Comma/space-separated KushMetaX account emails that get Doginal Dogs Plus without payment (restart server after change).
# Aliases: DD_COMPLIMENTARY_PLUS_EMAILS, DOGIDEX_COMPLIMENTARY_PLUS_EMAILS, COMPLIMENTARY_DD_PLUS_EMAILS
# DD_PLUS_COMPLIMENTARY_EMAILS=you@friends.com,colleague@example.org
# When DogiDex uses Supabase login, the server injects URL + anon key into
# GET /dd-evaluator/config.js (and /__dd_config). Set the SAME project here.
# Never put service_role in frontend JS or HTML.
# DOGIDEX_SUPABASE_URL=https://xxxx.supabase.co
# DOGIDEX_SUPABASE_ANON_KEY=eyJ...
# (aliases: SUPABASE_URL, SUPABASE_ANON_KEY)
# Optional override for magic-link / recover redirects:
# DOGIDEX_EMAIL_REDIRECT_URL=https://kushmedia.xyz/dd-evaluator

# Voyager / Nova Scotia map (kushmedia.xyz/map). Public Mapbox token is shipped to
# the browser at runtime via GET /api/voyager/config (cache-control: private 5 min).
# The server reads MAPBOX_ACCESS_TOKEN; NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN and
# VOYAGER_MAPBOX_TOKEN are accepted as aliases for compatibility with the legacy
# NovaScotiaVoyage Next.js .env.local file.
# MAPBOX_ACCESS_TOKEN=pk.eyJ1...

# --- NovaScotiaVoyage password lock ---
# /map and /api/voyager/* are protected by HTTP Basic Auth (timing-safe).
# DEFAULT BEHAVIOUR: if neither var below is set, /map returns 404 and the tool
# is hidden entirely. Set ONE of them to unlock the page (any non-empty string
# becomes the password). Use 24+ random characters for production.
#   VOYAGER_PASSWORD=put-a-32-char-random-secret-here
#   VOYAGER_PASSWORD_FILE=D:\path\to\.voyager-password   (gitignored, line 1 = password)
# Username at the browser prompt is ignored — only the password is checked.
# Optional escape hatch (NOT recommended in prod): make the page public again.
#   VOYAGER_PUBLIC=0

# --- DDL TCG companion (ddltcg.kushmetax.com, ddl.kushmedia.xyz, kushmedia.xyz/ddl) ---
# Same lock as Voyager: HTTP Basic Auth, timing-safe, 404 if unset.
# Username at the browser prompt is ignored — only the password is checked.
#   DDL_PASSWORD=put-a-32-char-random-secret-here
#   DDL_PASSWORD_FILE=/home/kushmetax/public_html/public/server/data/.ddl-password
# Dedicated subdomain ddltcg.kushmetax.com uses its own folder + .ddl-password
# (see D:\DDLTCG\deploy\kushmedia-ddl\FILE-MANAGER.md). Do not put that password here.
# Escape hatch (do not enable in production). Also hides the Prices tab while on:
#   DDL_PUBLIC=0

# BTC spot + CoinGecko — mirrors so gateways route like `/kk-auth`: /kk-btc /kmx-btc /dd-evaluator/btc /btc-public (+ CoinGecko mounts optional fallback)
# Demo key (CoinGecko "Demo API"): COINGECKO_API_KEY=CG-... — uses api.coingecko.com + x-cg-demo-api-key header
# Pro/paid key: set COINGECKO_API_KEY plus COINGECKO_PRO=1 — uses pro-api.coingecko.com + x-cg-pro-api-key header
# Local: set in .env. Production Passenger often skips custom vars in process.env — this server also reads COINGECKO from public/.env and server/data/.
# COINGECKO_API_KEY=
# COINGECKO_PRO=0
# COINGECKO_API_KEY_FILE=/absolute/path/to/key.txt
# Default file if unset (gitignored): public/server/data/.coingecko-api-key  (paste key alone on line 1)
# Alias env: CG_API_KEY=
# Diagnostics (no outbound call): GET /coingecko-status (simplest) or /healthz (includes coingecko summary) or …/kmx-coingecko/_status

# =============================================================================
# cPanel / LiteSpeed / Passenger (KushMetaX)
# =============================================================================
# Hidden files: In cPanel File Manager use Settings (gear) → Show Hidden Files (dotfiles)
#   or you will not see .env, .env.example, .session-secret, .coingecko-api-key, etc.
#
# Secrets (preferred): cPanel → Node.js / Setup Node.js App → Environment Variables.
#   Set at least: NODE_ENV=production, SESSION_SECRET (16+ random chars), COINGECKO_API_KEY,
#   DOGIDEX_SUPABASE_*, CRYPTO_PAY_*, PUBLIC_SITE_URL, etc. (see comments above).
#
# Alternative: copy this file to public/.env on the server only, fill real values, delete .example.
#   public/.env is gitignored — never commit it.
#
# Passenger app root should be the `public/` folder (see root .htaccess PassengerAppRoot). Upload the
# whole repo layout so `public/server`, `public/server.js`, site pages (dd-evaluator, *.html), and root
# .htaccess match your host paths; run npm install in the app directory if not using host auto-install.

# Legends Bracket (TanStack Start on :8080). Express proxies /tourney → this origin.
# TOURNEY_ORIGIN=http://127.0.0.1:8080
# Host-only: creating an arena requires this password (the Vite Node process reads it).
# Set it in cPanel Node env AND/OR in tourney/.env, or one line in the gitignored file:
#   TOURNEY_PASSWORD=put-a-32-char-random-secret-here
#   TOURNEY_PASSWORD_FILE=/home/kushmetax/public_html/public/server/data/.tourney-password
# File fallback (same pattern as DDL): public/server/data/.tourney-password
